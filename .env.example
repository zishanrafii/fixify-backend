PORT=5000
APP_BASE_URL="http://localhost:5000"
DATABASE_URL="postgresql://username:password@localhost:5432/skill_marketplace"
JWT_SECRET="replace-with-a-long-random-secret"

# Redis — shared storage for OTP, rate limiting, and future modules
# (Wallet, Booking, Notifications, Cache). Leave empty for local dev to run
# on an in-memory fallback (single-instance only, see src/services/redisService.js).
# Local: redis://localhost:6379   Production (TLS, managed Redis): rediss://...
REDIS_URL=

# Comma-separated list of allowed origins for CORS (e.g. web admin panel URL).
# Leave empty in local dev to allow all origins. Mobile apps don't send an
# Origin header, so they are unaffected by this setting either way.
ALLOWED_ORIGINS=

# Google Sign-In — OAuth 2.0 Client IDs from Google Cloud Console. Include
# every client ID your apps use (Android, iOS, Web), comma-separated — the
# token's audience must match one of these exactly.
GOOGLE_CLIENT_IDS=

# Apple Sign-In — your Services ID / app's bundle identifier (the audience
# Apple's identity token is issued for). From Apple Developer > Certificates,
# Identifiers & Profiles.
APPLE_CLIENT_ID=

# Facebook Login — from Meta for Developers > App Settings > Basic.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# SMS gateway (for OTP) — bulksmsbd.net-style API; see src/services/smsService.js
# if you use a different provider, only that file needs to change
SMS_API_KEY=
SMS_SENDER_ID=

# Email (booking status updates etc.) — SMTP, e.g. Gmail with an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Skill Marketplace <no-reply@example.com>"

# WhatsApp (Meta Cloud API) — see src/services/whatsappService.js for setup steps
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Payment gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Stripe (card / Google Pay / Apple Pay via PaymentSheet)
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks > (your endpoint) > Signing secret.
# Required — without this the webhook handler rejects every event (fails closed).
STRIPE_WEBHOOK_SECRET=
